# Copy this file to .env.local for local development, and add the same
# values in Vercel under Project -> Settings -> Environment Variables.

# Google Photos saving. A "Web application" OAuth client ID from Google Cloud.
# Not secret (it is visible in the page), but it only works on the web
# addresses you list in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AI helper for tricky photos. Secret: stays on the server.
# Without it the app still works, it just asks the user to place the corners
# more often.
ANTHROPIC_API_KEY=
